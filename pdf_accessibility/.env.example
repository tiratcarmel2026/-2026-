# ===== Claude API (required for automatic image alt-text) =====
# Get a key at https://console.anthropic.com/
# Without a key, the system still runs, but every image gets a generic
# fallback alt-text instead of a real Claude-generated description.
ANTHROPIC_API_KEY=

# Model used for vision alt-text generation.
ANTHROPIC_MODEL=claude-sonnet-5

# ===== Limits =====
MAX_FILE_SIZE_MB=50
MAX_PAGES=300

# ===== OCR =====
# Tesseract language packs to use, e.g. "heb+eng" or just "eng".
TESSERACT_LANGS=heb+eng
OCR_DPI=300
