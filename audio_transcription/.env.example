# ===== Limits =====
# A 3-4 hour recording is easily a few hundred MB.
MAX_FILE_SIZE_MB=1024

# ===== Whisper (Hebrew ASR) =====
# CTranslate2/faster-whisper model id. Default is an ivrit-ai model tuned for
# Hebrew - check https://huggingface.co/ivrit-ai for the current recommended
# release. On a CPU-only host (no GPU - e.g. Render), consider a smaller
# model if large-v3 is too slow/memory-heavy for your instance size.
WHISPER_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
WHISPER_DEVICE=cpu
# int8 on CPU; float16/int8_float16 if you have a GPU (set WHISPER_DEVICE=cuda)
WHISPER_COMPUTE_TYPE=int8

# ===== Diarization (who spoke when) =====
ENABLE_DIARIZATION=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu
# Hugging Face token with access to the gated diarization model:
# 1. Create a token at https://huggingface.co/settings/tokens
# 2. Accept the terms at https://huggingface.co/pyannote/speaker-diarization-3.1
#    and https://huggingface.co/pyannote/segmentation-3.0 (both required)
HF_TOKEN=

# ===== Speaker name guessing (optional) =====
# Without this, all speakers stay as "דובר 1" / "דובר 2" / ... until renamed
# manually in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
