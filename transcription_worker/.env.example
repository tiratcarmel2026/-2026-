# ===== Supabase (same project as the Next.js app) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===== Hugging Face (required for speaker diarization) =====
# 1. Create a token at https://huggingface.co/settings/tokens
# 2. Accept the terms at https://huggingface.co/pyannote/speaker-diarization-3.1
#    and https://huggingface.co/pyannote/segmentation-3.0 (both required)
HF_TOKEN=

# ===== Whisper (Hebrew ASR) =====
# CTranslate2/faster-whisper model id. Default is an ivrit-ai model tuned for
# Hebrew - check https://huggingface.co/ivrit-ai for the current recommended
# release. Falls back to plain "large-v3" (multilingual, worse Hebrew
# accuracy but always available) if you don't want the Hebrew-tuned one.
WHISPER_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
# "cuda" (recommended - a 3-4 hour recording on CPU can take many hours) or "cpu"
WHISPER_DEVICE=cuda
# float16/int8_float16 on GPU, int8 on CPU
WHISPER_COMPUTE_TYPE=float16

# ===== Diarization =====
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda

# ===== Speaker name guessing (optional) =====
# Without this, all speakers stay as "דובר 1" / "דובר 2" / ... until you
# rename them manually in the admin screen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

POLL_INTERVAL_SECONDS=10
