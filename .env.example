# ===== Supabase =====
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use the SERVICE ROLE key (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Same project, public values - safe to expose to the browser. Used only by
# the transcription upload screen to upload large recordings directly to
# Supabase Storage (via a short-lived signed URL) instead of through Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== Resend (transactional email) =====
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend
RESEND_FROM_EMAIL=booking@your-domain.co.il

# ===== Admin authentication (phase 1: per-department passwords) =====
# Long random string used to sign admin session cookies, e.g: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# One password per department id (see supabase/schema.sql for the full list).
# Env var name = ADMIN_PASSWORD_ + department id, uppercased, dashes -> underscores.
ADMIN_PASSWORD_BUSINESS_LICENSING=
ADMIN_PASSWORD_ENGINEERING=
ADMIN_PASSWORD_BILLING=
ADMIN_PASSWORD_WELFARE=
ADMIN_PASSWORD_EDUCATION=
ADMIN_PASSWORD_ENVIRONMENT=
# Password for the audio transcription admin screen (/admin/transcription).
ADMIN_PASSWORD_TRANSCRIPTION=

# ===== App =====
# Public base URL, used for links inside confirmation emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
